  background-repeat: no-repeat !important;
  background-attachment: fixed !important;
  font-family: var(--main-font) !important;
  -webkit-overflow-scrolling: touch !important;
}

/* © SaadBinYousaf */
.hl_login .hl_login--body {
  width: 100% !important;
