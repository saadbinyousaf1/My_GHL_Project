    class DateRangePicker {
        constructor() {
            this.startDate = null;
            this.endDate = null;

            const now = new Date();
            this.leftMonth = new Date(now.getFullYear(), now.getMonth(), 1);
            this.rightMonth = new Date(now.getFullYear(), now.getMonth() + 1, 1);

            this.container = null;
            this.popup = null;
            this.pill = null;
            this.resultsPanel = null;
            this.isOpen = false;
            this._eventsAttached = false;
        }

        formatDateShort(date) {
            if (!date) return '';
            const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
            return `${months[date.getMonth()]} ${date.getDate()}`;
        }

        formatMonthYear(date) {
            const months = ['January', 'February', 'March', 'April', 'May', 'June',
                          'July', 'August', 'September', 'October', 'November', 'December'];
            return `${months[date.getMonth()]} ${date.getFullYear()}`;
        }

        isSameDay(d1, d2) {
            if (!d1 || !d2) return false;
            return d1.getFullYear() === d2.getFullYear() &&
                   d1.getMonth() === d2.getMonth() &&
                   d1.getDate() === d2.getDate();
        }

        isInRange(date) {
            if (!this.startDate || !this.endDate) return false;
            return date > this.startDate && date < this.endDate;
        }

        isSelected(date) {
            return this.isSameDay(date, this.startDate) || this.isSameDay(date, this.endDate);
        }

        generateCalendarDays(monthDate) {
            const year = monthDate.getFullYear();
            const month = monthDate.getMonth();
            const firstDay = new Date(year, month, 1);
            const lastDay = new Date(year, month + 1, 0);
            const startPadding = firstDay.getDay();

            const days = [];
            const today = new Date();

            const prevMonth = new Date(year, month, 0);
            for (let i = startPadding - 1; i >= 0; i--) {
                const date = new Date(year, month - 1, prevMonth.getDate() - i);
                days.push({ date, excluded: true });
            }

            for (let i = 1; i <= lastDay.getDate(); i++) {
                const date = new Date(year, month, i);
                days.push({
                    date,
                    excluded: false,
                    today: this.isSameDay(date, today),
                    selected: this.isSelected(date),
                    inRange: this.isInRange(date)
                });
            }

            const remaining = 42 - days.length;
            for (let i = 1; i <= remaining; i++) {
                const date = new Date(year, month + 1, i);
                days.push({ date, excluded: true });
            }

            return days;
        }

        renderCalendar(monthDate, isLeft) {
            const days = this.generateCalendarDays(monthDate);

            const navLeft = isLeft ? `
                <div class="ghl-calendar-nav">
                    <button data-nav="prev-year">«</button>
                    <button data-nav="prev-month">‹</button>
                </div>
            ` : '<div class="ghl-calendar-nav"></div>';

            const navRight = !isLeft ? `
                <div class="ghl-calendar-nav">
                    <button data-nav="next-month">›</button>
                    <button data-nav="next-year">»</button>
                </div>
            ` : '<div class="ghl-calendar-nav"></div>';

            return `
                <div class="ghl-calendar">
                    <div class="ghl-calendar-header">
                        ${navLeft}
                        <div class="ghl-calendar-title">${this.formatMonthYear(monthDate)}</div>
                        ${navRight}
                    </div>
                    <div class="ghl-calendar-weekdays">
                        <div>Su</div><div>Mo</div><div>Tu</div><div>We</div><div>Th</div><div>Fr</div><div>Sa</div>
                    </div>
                    <div class="ghl-calendar-grid">
                        ${days.map(d => `
                            <div class="ghl-calendar-day ${d.excluded ? 'excluded' : ''} ${d.today ? 'today' : ''} ${d.selected ? 'selected' : ''} ${d.inRange ? 'in-range' : ''}"
                                 data-date="${d.date.getTime()}"
                                 data-selectable="${!d.excluded}">
                                ${d.date.getDate()}
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        getAuthStatus() {
            const auth = window.__GHL_AUTH__;
            if (auth.tokenId && auth.locationId) {
                return { ready: true, message: '✓ API Ready' };
            } else if (auth.tokenId) {
                return { ready: false, message: '⏳ Waiting for locationId...' };
            } else {
                return { ready: false, message: '⏳ Waiting for token...' };
            }
        }

        render() {
            if (!this.popup) return;

            const canConfirm = this.startDate && this.endDate;
            const authStatus = this.getAuthStatus();

            this.popup.innerHTML = `
                <div class="ghl-calendar-panel">
                    ${this.renderCalendar(this.leftMonth, true)}
                    <div class="ghl-calendar-divider"></div>
                    ${this.renderCalendar(this.rightMonth, false)}
                </div>
                <div class="ghl-calendar-footer">
                    <div class="ghl-calendar-status ${authStatus.ready ? 'ready' : ''}">${authStatus.message}</div>
                    <div class="ghl-calendar-actions">
                        <button class="ghl-calendar-btn secondary" data-action="clear">Clear</button>
                        <button class="ghl-calendar-btn primary" data-action="confirm" ${canConfirm && authStatus.ready ? '' : 'disabled'}>Apply Filter</button>
                    </div>
                </div>
            `;
        }

        attachCalendarEvents() {
            if (this._eventsAttached) return;
            this._eventsAttached = true;

            this.popup.addEventListener('click', (e) => {
                e.stopPropagation();

                const dayEl = e.target.closest('.ghl-calendar-day[data-selectable="true"]');
                if (dayEl) {
                    e.preventDefault();
                    const timestamp = parseInt(dayEl.dataset.date);
                    const date = new Date(timestamp);
                    this.selectDate(date);
                    return;
                }

                const navBtn = e.target.closest('[data-nav]');
                if (navBtn) {
                    e.preventDefault();
                    const action = navBtn.dataset.nav;

                    switch(action) {
                        case 'prev-year':
                            this.leftMonth = new Date(this.leftMonth.getFullYear() - 1, this.leftMonth.getMonth(), 1);
                            this.rightMonth = new Date(this.rightMonth.getFullYear() - 1, this.rightMonth.getMonth(), 1);
                            break;
                        case 'prev-month':
                            this.leftMonth = new Date(this.leftMonth.getFullYear(), this.leftMonth.getMonth() - 1, 1);
                            this.rightMonth = new Date(this.rightMonth.getFullYear(), this.rightMonth.getMonth() - 1, 1);
                            break;
                        case 'next-month':
                            this.leftMonth = new Date(this.leftMonth.getFullYear(), this.leftMonth.getMonth() + 1, 1);
                            this.rightMonth = new Date(this.rightMonth.getFullYear(), this.rightMonth.getMonth() + 1, 1);
                            break;
                        case 'next-year':
                            this.leftMonth = new Date(this.leftMonth.getFullYear() + 1, this.leftMonth.getMonth(), 1);
                            this.rightMonth = new Date(this.rightMonth.getFullYear() + 1, this.rightMonth.getMonth(), 1);
                            break;
                    }
                    this.render();
                    return;
                }

                const actionBtn = e.target.closest('[data-action]');
                if (actionBtn) {
                    e.preventDefault();
                    const action = actionBtn.dataset.action;

                    if (action === 'clear') {
                        this.clear();
                    } else if (action === 'confirm') {
                        this.confirm();
                    }
                }
            });

            this.popup.addEventListener('mouseover', (e) => {
                if (!this.startDate || this.endDate) return;

                const dayEl = e.target.closest('.ghl-calendar-day[data-selectable="true"]');
                if (!dayEl) return;

                const timestamp = parseInt(dayEl.dataset.date);
                const hoverDate = new Date(timestamp);
                this.updateRangePreview(hoverDate);
            });
        }

        updateRangePreview(hoverDate) {
            if (!this.startDate || this.endDate) return;

            const start = this.startDate < hoverDate ? this.startDate : hoverDate;
            const end = this.startDate < hoverDate ? hoverDate : this.startDate;

            this.popup.querySelectorAll('.ghl-calendar-day').forEach(dayEl => {
                const timestamp = parseInt(dayEl.dataset.date);
                const date = new Date(timestamp);

                const isStart = this.isSameDay(date, this.startDate);
                const isEnd = this.isSameDay(date, hoverDate);
                const isInRange = date > start && date < end;

                dayEl.classList.toggle('selected', isStart || isEnd);
                dayEl.classList.toggle('in-range', isInRange && !isStart && !isEnd);
            });
        }

        selectDate(date) {
            if (!this.startDate || (this.startDate && this.endDate)) {
                this.startDate = date;
                this.endDate = null;
            } else {
                if (date < this.startDate) {
                    this.endDate = this.startDate;
                    this.startDate = date;
                } else {
                    this.endDate = date;
                }
            }
            this.render();
        }

        clear() {
            this.startDate = null;
            this.endDate = null;

            window.__GHL_DATE_FILTER__.active = false;
            window.__GHL_DATE_FILTER__.startDate = null;
            window.__GHL_DATE_FILTER__.endDate = null;

            this.updatePill();
            this.hideResults();
            this.render();
        }

        async confirm() {
            if (!this.startDate || !this.endDate) return;

            const authStatus = this.getAuthStatus();
            if (!authStatus.ready) {
                alert('API not ready. Please wait for GHL to make a request first, or refresh the page.');
                return;
            }

            window.__GHL_DATE_FILTER__.active = true;
            window.__GHL_DATE_FILTER__.startDate = this.startDate;
            window.__GHL_DATE_FILTER__.endDate = this.endDate;

            console.log('📅 [UI] Filter set:', this.startDate.toLocaleDateString(), '-', this.endDate.toLocaleDateString());

            this.updatePill();
            this.hide();

            // Make direct API call with correct headers
            const results = await searchOpportunitiesAPI(this.startDate, this.endDate);

            if (results) {
                this.showResults(results);
            } else {
                alert('API request failed. Check console for details.');
            }
        }

        showResults(data) {
            const opportunities = data.opportunities || [];
            const total = data.total || 0;

            if (!this.resultsPanel) {
                this.resultsPanel = document.createElement('div');
                this.resultsPanel.className = 'ghl-api-results';
                document.body.appendChild(this.resultsPanel);
            }

            const startStr = this.formatDateShort(window.__GHL_DATE_FILTER__.startDate);
            const endStr = this.formatDateShort(window.__GHL_DATE_FILTER__.endDate);

            this.resultsPanel.innerHTML = `
                <div class="ghl-api-results-header">
                    <div class="ghl-api-results-title">📅 ${startStr} - ${endStr} (${total} total)</div>
                    <button class="ghl-api-results-close" onclick="this.closest('.ghl-api-results').classList.remove('show')">×</button>
                </div>
                <div class="ghl-api-results-body">
                    ${opportunities.length === 0 ? '<p style="color: #667085; text-align: center; padding: 20px;">No opportunities found in this date range.</p>' : ''}
                    ${opportunities.map(opp => {
                        const name = opp.name || opp.contact?.name || opp.contact?.email || 'Unnamed';
                        const value = opp.monetaryValue ? '$' + opp.monetaryValue.toLocaleString() : '';
                        const date = opp.dateAdded ? new Date(opp.dateAdded).toLocaleDateString() : '';
                        const status = opp.status || '';

                        return `
                            <div class="ghl-api-result-item" data-id="${opp.id}">
                                <div class="ghl-api-result-name">${name}</div>
                                <div class="ghl-api-result-details">
                                    ${value ? `<span class="ghl-api-result-value">${value}</span> | ` : ''}
                                    ${status} | Added: ${date}
                                </div>
                            </div>
                        `;
                    }).join('')}
                </div>
            `;

            this.resultsPanel.classList.add('show');
        }

        hideResults() {
            if (this.resultsPanel) {
                this.resultsPanel.classList.remove('show');
            }
        }

        updatePill() {
            if (!this.pill) return;

            const state = window.__GHL_DATE_FILTER__;
            if (state.active && state.startDate && state.endDate) {
                this.pill.innerHTML = `
                    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M21.75,3 C23.5449254,3 25,4.45507456 25,6.25 L25,21.75 C25,23.5449254 23.5449254,25 21.75,25 L6.25,25 C4.45507456,25 3,23.5449254 3,21.75 L3,6.25 C3,4.45507456 4.45507456,3 6.25,3 L21.75,3 Z M23.5,9.503 L4.5,9.503 L4.5,21.75 C4.5,22.7164983 5.28350169,23.5 6.25,23.5 L21.75,23.5 C22.7164983,23.5 23.5,22.7164983 23.5,21.75 L23.5,9.503 Z M21.75,4.5 L6.25,4.5 C5.28350169,4.5 4.5,5.28350169 4.5,6.25 L4.5,8.003 L23.5,8.003 L23.5,6.25 C23.5,5.28350169 22.7164983,4.5 21.75,4.5 Z"/>
                    </svg>
                    <span>${this.formatDateShort(state.startDate)} - ${this.formatDateShort(state.endDate)}</span>
                `;
                this.pill.classList.add('active');
            } else {
                this.pill.innerHTML = `
                    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M21.75,3 C23.5449254,3 25,4.45507456 25,6.25 L25,21.75 C25,23.5449254 23.5449254,25 21.75,25 L6.25,25 C4.45507456,25 3,23.5449254 3,21.75 L3,6.25 C3,4.45507456 4.45507456,3 6.25,3 L21.75,3 Z M23.5,9.503 L4.5,9.503 L4.5,21.75 C4.5,22.7164983 5.28350169,23.5 6.25,23.5 L21.75,23.5 C22.7164983,23.5 23.5,22.7164983 23.5,21.75 L23.5,9.503 Z M21.75,4.5 L6.25,4.5 C5.28350169,4.5 4.5,5.28350169 4.5,6.25 L4.5,8.003 L23.5,8.003 L23.5,6.25 C23.5,5.28350169 22.7164983,4.5 21.75,4.5 Z"/>
                    </svg>
                    <span>Date Range</span>
                `;
                this.pill.classList.remove('active');
            }
        }

        show() {
            if (!this.popup || this.isOpen) return;

            this.isOpen = true;
            this.popup.classList.add('show');

            const now = new Date();
            this.leftMonth = new Date(now.getFullYear(), now.getMonth(), 1);
            this.rightMonth = new Date(now.getFullYear(), now.getMonth() + 1, 1);

            const state = window.__GHL_DATE_FILTER__;
            if (state.active && state.startDate && state.endDate) {
                this.startDate = state.startDate;
                this.endDate = state.endDate;
                this.leftMonth = new Date(state.startDate.getFullYear(), state.startDate.getMonth(), 1);
                this.rightMonth = new Date(this.leftMonth.getFullYear(), this.leftMonth.getMonth() + 1, 1);
            }

            this.render();
        }

        hide() {
            if (!this.popup) return;
            this.isOpen = false;
            this.popup.classList.remove('show');
        }

        toggle() {
            if (this.isOpen) this.hide();
            else this.show();
        }

        create() {
            injectStyles();

            this.container = document.createElement('div');
            this.container.className = 'ghl-date-container';
            this.container.id = 'ghl-date-picker-container';

            this.pill = document.createElement('button');
            this.pill.className = 'ghl-date-pill';
            this.pill.innerHTML = `
                <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M21.75,3 C23.5449254,3 25,4.45507456 25,6.25 L25,21.75 C25,23.5449254 23.5449254,25 21.75,25 L6.25,25 C4.45507456,25 3,23.5449254 3,21.75 L3,6.25 C3,4.45507456 4.45507456,3 6.25,3 L21.75,3 Z M23.5,9.503 L4.5,9.503 L4.5,21.75 C4.5,22.7164983 5.28350169,23.5 6.25,23.5 L21.75,23.5 C22.7164983,23.5 23.5,22.7164983 23.5,21.75 L23.5,9.503 Z M21.75,4.5 L6.25,4.5 C5.28350169,4.5 4.5,5.28350169 4.5,6.25 L4.5,8.003 L23.5,8.003 L23.5,6.25 C23.5,5.28350169 22.7164983,4.5 21.75,4.5 Z"/>
                </svg>
                <span>Date Range</span>
            `;

            this.popup = document.createElement('div');
            this.popup.className = 'ghl-calendar-popup';

            this.container.appendChild(this.pill);
            this.container.appendChild(this.popup);

            this.attachCalendarEvents();

            this.pill.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                this.toggle();
            });

            document.addEventListener('click', (e) => {
                if (this.isOpen && !this.container.contains(e.target)) {
                    this.hide();
                }
            });

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && this.isOpen) {
                    this.hide();
                }
            });

            return this.container;
        }
    }

    // =================================
    // INJECT INTO PAGE
    // =================================

    let picker = null;

    function injectDatePicker() {
        if (document.getElementById('ghl-date-picker-container')) return true;

        const sortBtn = document.querySelector('.sort-btn') ||
                       document.querySelector('#list-view-sort-btn')?.closest('div.sort-btn') ||
                       document.querySelector('[id*="sort-btn"]')?.parentElement;

        if (!sortBtn) return false;

        picker = new DateRangePicker();
        const element = picker.create();

        if (sortBtn.nextSibling) {
            sortBtn.parentNode.insertBefore(element, sortBtn.nextSibling);
        } else {
            sortBtn.parentNode.appendChild(element);
        }

        console.log('✅ [GHL-DatePicker-v5] Injected');
        return true;
    }

    function init() {
        if (!window.location.href.includes('/opportunities')) {
            setTimeout(init, 1000);
            return;
        }

        let attempts = 0;
        const tryInject = () => {
            if (injectDatePicker() || attempts > 40) return;
            attempts++;
            setTimeout(tryInject, 500);
        };

        setTimeout(tryInject, 1500);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    let lastUrl = '';
    setInterval(() => {
        if (window.location.href !== lastUrl) {
            lastUrl = window.location.href;
            document.getElementById('ghl-date-picker-container')?.remove();
            picker = null;
            if (window.location.href.includes('/opportunities')) {
                setTimeout(init, 1000);
            }
        }
    }, 500);

    console.log('📅 [GHL-DatePicker-v5] Ready!');

})();
