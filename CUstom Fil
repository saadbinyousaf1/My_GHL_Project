    // =================================
    // XHR INTERCEPTOR - Capture Headers
    // =================================

    const OrigXHR = window.XMLHttpRequest;

    function createInterceptedXHR() {
        const xhr = new OrigXHR();
        const requestInfo = { url: null, method: null, headers: {} };

        const _open = xhr.open;
        const _send = xhr.send;
        const _setRequestHeader = xhr.setRequestHeader;

        xhr.open = function(method, url, async, user, pass) {
            requestInfo.method = method;
            requestInfo.url = url;
            return _open.apply(xhr, arguments);
        };

        xhr.setRequestHeader = function(header, value) {
            requestInfo.headers[header] = value;

            // Capture token-id (the key header!)
            if (header.toLowerCase() === 'token-id') {
                window.__GHL_AUTH__.tokenId = value;
                console.log('🔑 [AUTH] Captured token-id');
            }

            // Capture all headers for reuse
            window.__GHL_AUTH__.allHeaders[header] = value;

            return _setRequestHeader.apply(xhr, arguments);
        };

        xhr.send = function(body) {
            // Capture location ID and pipeline ID from request body
            if (requestInfo.url?.includes('opportunities/search') && body) {
                try {
                    const data = JSON.parse(body);
                    if (data.locationId) {
                        window.__GHL_AUTH__.locationId = data.locationId;
                        console.log('📍 [AUTH] Captured locationId:', data.locationId);
                    }
                    if (data.filters) {
                        const pipelineFilter = data.filters.find(f => f.field === 'pipeline_id');
                        if (pipelineFilter) {
                            window.__GHL_AUTH__.pipelineId = pipelineFilter.value;
                            console.log('🔗 [AUTH] Captured pipelineId:', pipelineFilter.value);
                        }
                    }
                } catch(e) {}
            }

            return _send.apply(xhr, arguments);
        };

        return xhr;
    }

    window.XMLHttpRequest = function() {
        return createInterceptedXHR();
    };

    Object.keys(OrigXHR).forEach(k => {
        try { window.XMLHttpRequest[k] = OrigXHR[k]; } catch(e) {}
    });
    window.XMLHttpRequest.prototype = OrigXHR.prototype;

    console.log('✅ [XHR] Header interceptor installed');

    // =================================
    // FETCH INTERCEPTOR
    // =================================

    const OrigFetch = window.fetch;

    window.fetch = async function(url, options = {}) {
        const urlStr = typeof url === 'string' ? url : url.toString();

        // Capture headers from fetch requests
        if (urlStr.includes('leadconnectorhq.com') && options.headers) {
            const headers = options.headers;

            if (headers instanceof Headers) {
                headers.forEach((value, key) => {
                    window.__GHL_AUTH__.allHeaders[key] = value;
                    if (key.toLowerCase() === 'token-id') {
                        window.__GHL_AUTH__.tokenId = value;
                        console.log('🔑 [FETCH-AUTH] Captured token-id');
                    }
                });
            } else if (typeof headers === 'object') {
                Object.entries(headers).forEach(([key, value]) => {
                    window.__GHL_AUTH__.allHeaders[key] = value;
                    if (key.toLowerCase() === 'token-id') {
                        window.__GHL_AUTH__.tokenId = value;
                        console.log('🔑 [FETCH-AUTH] Captured token-id');
                    }
                });
            }
        }

        // Capture locationId from body
        if (urlStr.includes('opportunities/search') && options.body) {
            try {
                const data = JSON.parse(options.body);
                if (data.locationId) {
                    window.__GHL_AUTH__.locationId = data.locationId;
                }
                if (data.filters) {
                    const pipelineFilter = data.filters.find(f => f.field === 'pipeline_id');
                    if (pipelineFilter) {
                        window.__GHL_AUTH__.pipelineId = pipelineFilter.value;
                    }
                }
            } catch(e) {}
        }

        return OrigFetch.call(this, url, options);
    };

    console.log('✅ [FETCH] Header interceptor installed');

    // =================================
    // DIRECT API CALL WITH CORRECT HEADERS
    // =================================

    async function searchOpportunitiesAPI(startDate, endDate) {
        const auth = window.__GHL_AUTH__;

        if (!auth.tokenId) {
            console.error('❌ No token-id captured yet. Wait for GHL to make a request first.');
            return null;
        }

        if (!auth.locationId) {
            console.error('❌ No locationId captured yet.');
            return null;
        }

        const startOfDay = new Date(startDate.getFullYear(), startDate.getMonth(), startDate.getDate(), 0, 0, 0, 0).getTime();
        const endOfDay = new Date(endDate.getFullYear(), endDate.getMonth(), endDate.getDate(), 23, 59, 59, 999).getTime();

        const requestBody = {
            sort: [{ field: 'date_added', direction: 'desc' }],
            query: '',
            locationId: auth.locationId,
            additionalDetails: {
                notes: true,
                tasks: true,
                calendarEvents: true,
                unReadConversations: true
            },
            filters: [
                {
                    field: 'date_added',
                    operator: 'range',
                    value: {
                        gte: startOfDay,
                        lte: endOfDay
                    }
                }
            ],
            limit: 50,
            page: 1,
            aggregations: [
                {
                    name: 'pipeline_stages',
                    type: 'terms',
                    field: 'pipeline_stage_id',
                    size: 100,
                    aggregations: [
                        { name: 'revenues', type: 'sum', field: 'monetary_value' }
                    ]
                }
            ],
            includeTopRelations: true
        };

        // Add pipeline filter if we have one
        if (auth.pipelineId) {
            requestBody.filters.unshift({
                field: 'pipeline_id',
                operator: 'eq',
                value: auth.pipelineId
            });
        }

        console.log('📤 [API] Making request with correct headers...');
        console.log('📤 [API] Date range:', startDate.toLocaleDateString(), '-', endDate.toLocaleDateString());
        console.log('📤 [API] Token-id present:', !!auth.tokenId);

        try {
            // Use exact same headers as GHL
            const response = await fetch('https://services.leadconnectorhq.com/opportunities/search', {
                method: 'POST',
                headers: {
                    'Accept': 'application/json, text/plain, */*',
                    'Content-Type': 'application/json',
                    'channel': 'APP',
                    'source': 'WEB_USER',
                    'version': '2021-07-28',
                    'token-id': auth.tokenId
                },
                body: JSON.stringify(requestBody)
            });

            console.log('📥 [API] Response status:', response.status);

            if (!response.ok) {
                const errText = await response.text();
                console.error('❌ [API] Request failed:', response.status, errText);
                return null;
            }

            const data = await response.json();
            console.log('✅ [API] Success! Found', data.opportunities?.length || 0, 'opportunities, total:', data.total);

            return data;

        } catch (err) {
            console.error('❌ [API] Error:', err);
            return null;
        }
    }

